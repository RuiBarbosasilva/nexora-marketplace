{
  "name": "nexora-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA - plataforma de comercio inteligente",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
